# Copy to .env and adjust. Every value below has a working default except
# DATABASE_URL, which defaults to a local SQLite file.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated origins, or * for any origin.
CORS_ORIGIN=*

# SQLite (default): file:./dev.db  -> packages/backend/prisma/dev.db
# PostgreSQL:       postgresql://user:password@host:5432/chronoflow?schema=public
#                   (run `pnpm db:use-postgres` first)
DATABASE_URL=file:./dev.db

# Stellar / Soroban. Defaults come from the generated contract module
# (packages/backend/src/generated/chronoflow.ts) so they track the deployment.
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Contract id written by `pnpm --filter @chronoflow/contracts run deploy:testnet`
CONTRACT_ID=

# Display decimals for base-unit amounts (7 = stroops, 1 XLM).
TOKEN_DECIMALS=7

# Indexer
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_SIZE=200
# Optional: first ledger to scan. Defaults to the ledger the contract was
# deployed in (recorded by the deploy script).
# INDEXER_START_LEDGER=

LOG_LEVEL=info
