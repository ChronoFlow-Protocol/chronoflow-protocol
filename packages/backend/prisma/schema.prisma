// ChronoFlow indexer storage.
//
// Defaults to SQLite so a fresh clone runs with zero infrastructure. To use
// PostgreSQL instead, run `pnpm db:use-postgres` (it swaps in
// prisma/schema.postgres.prisma) and point DATABASE_URL at your database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Current state of a vault, folded from the contract's events.
model Vault {
  id       Int    @id
  funder   String
  recipient String
  token    String

  /// Amounts are stored as decimal strings so i128 values survive SQLite.
  totalAmount         String
  amountPerMilestone  String
  amountReleased      String

  duration            Int
  milestones          Int
  milestonesReleased  Int
  startTime           BigInt
  clawbackTime        BigInt
  status              String

  /// Ledger and tx that created the vault.
  createdLedger   Int
  createdTxHash   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  milestonesRef Milestone[]

  @@index([funder])
  @@index([recipient])
  @@index([status])
}

/// Per-milestone progress, materialised from VaultCreated + MilestoneReleased.
model Milestone {
  id      Int @id @default(autoincrement())
  vaultId Int
  index   Int
  amount  String
  unlockTime BigInt
  released   Boolean @default(false)
  releasedAt BigInt?
  releaseTxHash String?
  releaseLedger Int?

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([vaultId, index])
  @@index([vaultId, released])
}

/// Append-only log of every contract event the indexer consumed. Replaying it
/// is what makes the indexer idempotent and reorg-safe.
model VaultEvent {
  id          Int      @id @default(autoincrement())
  /// Soroban RPC event id (`<ledger>-<tx>-<event index>`).
  eventId     String   @unique
  /// Vault the event refers to. Deliberately not a foreign key: the log has to
  /// accept events for vaults whose creation falls outside the indexer's cursor
  /// (for example before an RPC retention window), and losing them would
  /// silently drop real protocol history.
  vaultId     Int?
  topic       String
  kind        String
  ledger      Int
  txHash      String
  contractId  String
  payload     String
  occurredAt  BigInt
  ingestedAt  DateTime @default(now())

  @@index([vaultId])
  @@index([kind])
  @@index([ledger])
}

/// Resume point for the event poller.
model IndexerCursor {
  id         Int      @id @default(autoincrement())
  contractId String   @unique
  lastLedger Int
  updatedAt  DateTime @updatedAt
}
